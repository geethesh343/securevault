{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and vault security settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique Firebase user UID" },
        "name": { "type": "string", "description": "Full name of the account holder" },
        "email": { "type": "string", "format": "email", "description": "User primary email address" },
        "avatar": { "type": "string", "description": "Avatar URL or placeholder" },
        "role": { "type": "string", "enum": ["owner", "family_member"], "description": "Vault access role" },
        "storageUsedBytes": { "type": "number", "description": "Bytes used in Cloud Storage" },
        "twoFactorEnabled": { "type": "boolean", "description": "Whether 2FA is active" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role"]
    },
    "DocumentRecord": {
      "title": "DocumentRecord",
      "description": "Stored digital identity, insurance, deed, tax, or legal document metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document unique identifier" },
        "ownerId": { "type": "string", "description": "Firebase UID of owner" },
        "title": { "type": "string", "description": "Document title" },
        "category": { "type": "string", "description": "Document category" },
        "fileName": { "type": "string", "description": "Original file name" },
        "fileType": { "type": "string", "description": "MIME type" },
        "fileSize": { "type": "string", "description": "Human-readable file size" },
        "storagePath": { "type": "string", "description": "Cloud Storage path under users/{uid}/" },
        "downloadUrl": { "type": "string", "description": "Cloud Storage download URL" },
        "ocrSummary": { "type": "string", "description": "AI OCR extraction summary" },
        "documentNumber": { "type": "string", "description": "Document or policy number" },
        "issuingAuthority": { "type": "string", "description": "Issuing agency or company" },
        "issueDate": { "type": "string", "description": "Date of issue" },
        "expiryDate": { "type": "string", "description": "Date of expiration" },
        "renewalDate": { "type": "string", "description": "Date for renewal" },
        "amount": { "type": "number", "description": "Financial amount if applicable" },
        "verifiedStatus": { "type": "string", "enum": ["Verified", "Pending", "Needs Review"] },
        "isFavorite": { "type": "boolean", "description": "Whether starred by user" },
        "tags": { "type": "array", "description": "Metadata tags" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "category"]
    },
    "SubscriptionRecord": {
      "title": "SubscriptionRecord",
      "description": "Recurring digital service subscription",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Subscription unique ID" },
        "ownerId": { "type": "string", "description": "Firebase UID of owner" },
        "serviceName": { "type": "string", "description": "Service name" },
        "provider": { "type": "string", "description": "Vendor or company" },
        "category": { "type": "string", "description": "Subscription category" },
        "cost": { "type": "number", "description": "Billing amount" },
        "currency": { "type": "string", "description": "ISO currency code" },
        "billingCycle": { "type": "string", "enum": ["Monthly", "Yearly", "Quarterly"] },
        "nextRenewalDate": { "type": "string", "description": "Upcoming charge date" },
        "paymentMethod": { "type": "string", "description": "Payment card or account" },
        "autoRenew": { "type": "boolean" },
        "remindersEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "serviceName", "cost"]
    },
    "BillRecord": {
      "title": "BillRecord",
      "description": "Household or utility invoice and due date item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Bill unique ID" },
        "ownerId": { "type": "string", "description": "Firebase UID of owner" },
        "title": { "type": "string", "description": "Bill description" },
        "biller": { "type": "string", "description": "Utility or billing entity" },
        "category": { "type": "string", "description": "Expense category" },
        "amount": { "type": "number", "description": "Bill amount" },
        "currency": { "type": "string", "description": "Currency code" },
        "dueDate": { "type": "string", "description": "Due date" },
        "status": { "type": "string", "enum": ["Pending", "Paid", "Overdue"] },
        "recurring": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "amount", "dueDate", "status"]
    },
    "CredentialRecord": {
      "title": "CredentialRecord",
      "description": "Secure password and account credential record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Credential unique ID" },
        "ownerId": { "type": "string", "description": "Firebase UID of owner" },
        "title": { "type": "string", "description": "Account or service title" },
        "username": { "type": "string", "description": "Account login or email" },
        "password": { "type": "string", "description": "Account password or secure pin" },
        "website": { "type": "string", "description": "Website or app URL" },
        "category": { "type": "string", "description": "Category" },
        "twoFactorSecret": { "type": "string", "description": "Optional 2FA backup code" },
        "notes": { "type": "string", "description": "Encrypted notes" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "username", "password"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and vault metadata"
    },
    "/users/{userId}/documents/{documentId}": {
      "schema": { "$ref": "#/entities/DocumentRecord" },
      "description": "Digital documents and certificates scoped to user"
    },
    "/users/{userId}/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/SubscriptionRecord" },
      "description": "User digital subscriptions and recurring renewals"
    },
    "/users/{userId}/bills/{billId}": {
      "schema": { "$ref": "#/entities/BillRecord" },
      "description": "User bills, utility deadlines, and payment tracking"
    },
    "/users/{userId}/credentials/{credentialId}": {
      "schema": { "$ref": "#/entities/CredentialRecord" },
      "description": "Encrypted passwords and logins scoped to user"
    }
  }
}

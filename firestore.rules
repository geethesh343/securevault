rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connectivity verification document
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // User Profile: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == userId;
      allow delete: if isOwner(userId);

      // Subcollection: Documents
      match /documents/{documentId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(documentId)
          && request.resource.data.ownerId == userId;
        allow update: if isOwner(userId)
          && isValidId(documentId)
          && request.resource.data.ownerId == userId;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Subscriptions
      match /subscriptions/{subscriptionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(subscriptionId)
          && request.resource.data.ownerId == userId;
        allow update: if isOwner(userId)
          && isValidId(subscriptionId)
          && request.resource.data.ownerId == userId;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Bills
      match /bills/{billId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(billId)
          && request.resource.data.ownerId == userId;
        allow update: if isOwner(userId)
          && isValidId(billId)
          && request.resource.data.ownerId == userId;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Credentials
      match /credentials/{credentialId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(credentialId)
          && request.resource.data.ownerId == userId;
        allow update: if isOwner(userId)
          && isValidId(credentialId)
          && request.resource.data.ownerId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}

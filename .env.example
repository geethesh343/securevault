# LifeVault AI Environment Configuration Example

# GEMINI_API_KEY: Required for server-side Gemini AI features (Document OCR, Smart Search, Chat Assistant).
# In Google AI Studio, this is securely injected from environment secrets.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# PORT: Server listening port (default: 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted (e.g. http://localhost:3000 in local dev)
APP_URL="http://localhost:3000"

# Note on Firebase Configuration:
# Frontend Firebase initialization parameters are securely loaded from firebase-applet-config.json.
# For local Windows development or Firebase CLI deployment, see README.md for instructions.
